   "link": null,
   "locked": false,
   "text": "CREATE FUNCTION ccl.law.ent_vs_competitor(\n  segment STRING, competitor BOOLEAN, disc DOUBLE)\nRETURNS BOOLEAN\nCOMMENT 'support 722 \u00b7 replay precision 0.929 \u00b7\n         outcome lift +0.05 \u00b7 steward: deal desk'\nRETURN segment = 'ENT' AND competitor\n       AND disc <= 30;",
   "originalText": "CREATE FUNCTION ccl.law.ent_vs_competitor(\n  segment STRING, competitor BOOLEAN, disc DOUBLE)\nRETURNS BOOLEAN\nCOMMENT 'support 722 \u00b7 replay precision 0.929 \u00b7\n         outcome lift +0.05 \u00b7 steward: deal desk'\nRETURN segment = 'ENT' AND competitor\n       AND disc <= 30;",
